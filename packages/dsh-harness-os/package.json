{
  "name": "dsh-harness-os",
  "version": "0.1.0",
  "description": "DeepSeek Harness 主界面皮肤「Harness OS」：沿用 dsh-startup-screen 开机动画的技术档案版式——暖白 / 暗色底板、发丝机框、等宽读数、准星罗盘。开机动画揭幕时原地接住常驻件，其余部件按同一节奏装配。纯客户端插件，不改 DSH 源码。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "ui"
  ],
  "license": "MIT",
  "author": "TinyNian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyNian/dsh-harness-os.git",
    "directory": "packages/dsh-harness-os"
  },
  "homepage": "https://github.com/TinyNian/dsh-harness-os#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
